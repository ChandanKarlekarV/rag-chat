# Copy to .env (cp .env.example .env). Never commit .env.
# Comments must be on their own line (some .env parsers keep inline text as part of the value).

# --- app ---
# "prod" turns on Secure cookies and refuses a placeholder SECRET_KEY.
APP_ENV=dev
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-before-deploying
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# --- answer modes (see ANSWER_MODES.md) ---
# Auto-selection per user: API key available -> Claude API; else Ollama reachable -> Ollama; else Local.
# Users can switch modes above the question box; their choice is saved to their account.

# Local mode (extractive: quotes your PDF, no key, no internet).
# Most accurate measured: deepset/deberta-v3-large-squad2. Lighter: deepset/roberta-base-squad2
QA_MODEL=deepset/deberta-v3-large-squad2
MIN_QA_SCORE=0.05
QA_WEIGHT=0.6
MAX_SENTENCES=3

# Ollama mode (optional): a model running on your own computer. In Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# API key mode. Leave blank: each user can paste their own key from any supported provider in
# Settings (never stored on the server). Set ONE shared server key only if you want one:
ANTHROPIC_API_KEY=
# Current Sonnet model id, from platform.claude.com/docs (models overview).
LLM_MODEL=claude-sonnet-5-5
# ...or a key from another provider: openai, gemini, groq, openrouter, mistral, deepseek, xai (auto = detect).
LLM_API_KEY=
LLM_PROVIDER=auto
LLM_API_MODEL=

# --- hardware ---
# auto = use an NVIDIA GPU when one is available, else the CPU. TORCH_THREADS caps CPU use (0 = all cores).
DEVICE=auto
TORCH_THREADS=0
# --- retrieval ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVE_K=20
FINAL_K=5
# Tuned with: python scripts/evaluate.py --sweep
MIN_RERANK_SCORE=-5.0

# --- multi-server (optional; see docker-compose.scale.yml) ---
# DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag
REDIS_URL=
CHROMA_URL=

# --- limits ---
MAX_UPLOAD_MB=100
