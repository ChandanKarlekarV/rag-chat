# Copy to .env to override defaults. Never commit .env.
# Leave ANTHROPIC_API_KEY blank: each user pastes their own key in the app's "API key" screen.
# Set it only if you want one shared key used for every visitor.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60

EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
CANDIDATES=20
RRF_K=60
# Cross-encoder logit below which the question is refused without calling the LLM.
# Tuned with `python scripts/evaluate.py --sweep`; see README "Design decisions".
MIN_RERANK_SCORE=-5.0

MAX_UPLOAD_MB=20
DATA_DIR=./data
