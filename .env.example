# Copy to .env (cp .env.example .env). Never commit .env.
# Comments must be on their own line (some .env parsers keep inline text as part of the value).

# --- app ---
# "prod" turns on Secure cookies and refuses a placeholder SECRET_KEY.
APP_ENV=dev
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-before-deploying
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# --- LLM ---
# Leave blank: each user pastes their own key in Settings. Set it only to share one key with every visitor.
ANTHROPIC_API_KEY=
# "anthropic", or "fake" for an offline demo (extractive answers, no key needed).
LLM_PROVIDER=anthropic
# Current Sonnet model id, from platform.claude.com/docs (models overview).
LLM_MODEL=claude-sonnet-5-5

# --- retrieval ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVE_K=20
FINAL_K=5
# Tuned with: python scripts/evaluate.py --sweep
MIN_RERANK_SCORE=-5.0

# --- limits ---
MAX_UPLOAD_MB=20
